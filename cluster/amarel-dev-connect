#!/usr/bin/env bash
# amarel-dev-connect -- the connect-time brain for ssh host `amarel-dev`.
#
# Installs to ~/bin/amarel-dev-connect and runs ON THE CLUSTER, driven from the
# laptop by one line of ssh_config:
#
#     ProxyCommand ssh -q amarel-jump bin/amarel-dev-connect
#
# THE BRAIN LIVES HERE, NOT ON THE LAPTOP. The prototype ran this logic as a
# bash script on the laptop, and that single choice caused most of its
# difficulty: `%N` in a script but `%%N` in ssh_config because only ssh_config
# percent-expands; single quotes around the remote script or the laptop shell
# runs squeue locally; and being bash at all meant Windows got nothing. Moving
# it here makes the laptop side one line that is byte-identical on macOS,
# Linux and Windows, and it is why Cursor and Positron work with no per-client
# code. Do not move it back.
#
# STDOUT IS THE SSH TUNNEL. Every byte written to stdout is fed into the SSH
# byte stream. Only `nc` may own stdout. Progress notes go to the log file,
# never to the terminal.
#
# Measured 2026-08-21, and narrower than an earlier draft of this comment
# claimed: one whole line emitted BEFORE the server's identification string is
# tolerated. RFC 4253 section 4.2 says the server "MAY send other lines of data
# before sending the version string" and "Clients MUST be able to process such
# lines". A test that appended `echo NOISE-TEST-PHASE13` to the cluster
# ~/.bashrc still connected to gpuk008, with the noise printed above it.
#
# What is NOT tolerated: anything written after the banner, a partial line, and
# any line beginning with "SSH-" (the RFC forbids those). The setup's hard gate
# still refuses ANY output, because the difference is not worth betting a
# connection on and the noise is printed to the user on every single connect.
#
# DO NOT ADD A RETRY LOOP. The editor already retries on its own schedule; a
# loop here multiplies against it and recreates the endless reconnect this
# script exists to fix. Single shot: provision, wait inside the budget, then
# succeed or exit fast with a readable reason.
#
# ---------------------------------------------------------------------------
# TIME BUDGET. Every wait sums over the LONGEST PATH, not per step, and the
# total must stay under the editor's 300s ceiling:
#
#     repair_pending 20   settle 20 x 3s   =  60s
#     provision           flock + sbatch   = 150s
#     repair_pending 10   settle 10 x 3s   =  30s
#                                    total   240s
#     plus 3-25s of ssh connect overhead  ->  ~265s against 300s
#
# An earlier draft used `flock -w 330`, exceeded the ceiling, and the editor
# SIGKILLed the proxy before any diagnostic reached the user: a silent hang. A
# helper must always fail faster than its caller's patience. If any wait
# lengthens, re-add the whole column.
# ---------------------------------------------------------------------------
set -uo pipefail

LIB="${AMAREL_DEV_LIB:-$HOME/bin/amarel-dev-lib}"
if [ ! -r "$LIB" ]; then
	echo "amarel-dev: $LIB is missing, re-run the Amarel setup. Details: bin/dev-session status" >&2
	exit 1
fi
# shellcheck source=./amarel-dev-lib
. "$LIB"
adl_load_conf

LOGFILE="$ADL_LOG_DIR/connect.log"
LASTFAIL="$ADL_LOG_DIR/last-failure"

# Anchor for note()'s elapsed field. Captured before any work so every line is
# measured from the same instant.
#
# `date +%s%3N` is GNU-only. That is safe on the cluster, where --selftest
# already refuses to pass without GNU `date -d` because every maintenance
# calculation needs it.
#
# VALIDATE THE VALUE, DO NOT TRUST THE EXIT STATUS. BSD date does not fail on
# an unknown %3N: it emits the literal characters "3N" and exits 0. So a `||`
# fallback never fires, and `$(( 17890156433N - ... ))` is an arithmetic syntax
# error rather than a missing field. Measured on macOS 2026-09-10. T0=0 means
# "no millisecond clock", and note() then prints +? instead of a wrong number.
T0="$(date +%s%3N 2>/dev/null)"
case "$T0" in '' | *[!0-9]*) T0=0 ;; esac

# Progress goes to the log. On failure we emit ONE line on stderr and also
# record it to $LASTFAIL.
#
# THE STDERR LINE OFTEN DOES NOT REACH THE USER, AND THAT IS NOT A BUG WE CAN
# FIX HERE. Measured 2026-08-21: with `ControlPersist` set on Host amarel-dev,
# which is what ships, OpenSSH detaches the master and sends its standard file
# descriptors to /dev/null, so a failing ProxyCommand's stderr is discarded.
# From ssh.c, control_persist_detach():
#     if (stdfd_devnull(1, 1, !(log_is_on_stderr() && debug_flag)) == -1)
# stderr survives only when debug_flag is set, i.e. `ssh -v`. Verified both
# ways: a plain connect shows only "Connection closed by UNKNOWN port 65535",
# and `ssh -v amarel-dev` shows the real line. stdout is not an alternative,
# ssh discards pre-banner output from a failing ProxyCommand.
#
# Dropping ControlPersist would restore the line, but it also makes the first
# window own the master: closing it then kills every other window. Measured the
# same day. Keeping windows independent is worth more than the message.
#
# $LASTFAIL is therefore the channel that actually works. `dev-session status`
# prints it, and the skill's Phase 13.10 reads it to diagnose a failed connect.
# Keep the stderr line anyway: it is what a CLI user and `ssh -v` see.
#
# ---------------------------------------------------------------------------
# Two changes from the original single-stamp version, both from issue #33:
#
#   1. The stamp carries a timezone offset and milliseconds. The old
#      '%Y-%m-%dT%H:%M:%S' was local time with no offset at one-second
#      resolution, so it could not order two lines across a DST change and
#      could not measure anything shorter than a second. A warm connect is
#      0.4s, so one-second resolution measured it as zero.
#   2. An elapsed field, +N.NNNs since T0. This is the half that actually
#      answers "which stage was slow". Before it, a warm connect wrote exactly
#      one line and no duration existed anywhere in the log, so the question
#      #33 asks was unanswerable from the evidence the script produced.
# ---------------------------------------------------------------------------
note() {
	mkdir -p "$ADL_LOG_DIR" 2>/dev/null
	local now el ms
	now="$(date '+%Y-%m-%dT%H:%M:%S.%3N%z' 2>/dev/null)"
	# Same BSD trap as T0 above: check the output, not the exit status.
	case "$now" in '' | *3N*) now="$(date '+%Y-%m-%dT%H:%M:%S%z')" ;; esac
	el="+?"
	if [ "$T0" != 0 ]; then
		ms="$(date +%s%3N 2>/dev/null)"
		case "$ms" in '' | *[!0-9]*) ms="$T0" ;; esac
		ms=$((ms - T0))
		el="$(printf '+%d.%03ds' "$((ms / 1000))" "$((ms % 1000))")"
	fi
	printf '%s %s %s\n' "$now" "$el" "$*" >>"$LOGFILE" 2>/dev/null
}
fail() {
	note "FAILED: $*"
	# Written before the stderr line, because the stderr line is the half that
	# usually gets discarded. Single line, timestamped, overwritten each time:
	# the skill wants the CURRENT failure, and connect.log keeps the history.
	mkdir -p "$ADL_LOG_DIR" 2>/dev/null
	printf '%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >"$LASTFAIL" 2>/dev/null
	printf 'amarel-dev: %s Details: bin/dev-session status\n' "$*" >&2
	exit 1
}

# --------------------------------------------------------------------------
# --selftest: run directly over ssh, not as a ProxyCommand, so stdout is safe.
# Phase 13 of setup.sh gates writing the ssh_config blocks on this passing,
# because a config written before the cluster side works produces a first click
# that fails with "No such file or directory".
# --------------------------------------------------------------------------
if [ "${1:-}" = "--selftest" ]; then
	rc=0
	echo "amarel-dev-connect selftest on $(hostname -s)"
	echo "  conf:      $ADL_CONF $([ -r "$ADL_CONF" ] && echo present || echo MISSING)"
	echo "  partition: ${ADL_PARTITION:-<unset>}"
	echo "  request:   $ADL_CPUS cores, $ADL_MEM, $ADL_WALLTIME"
	echo "  log dir:   $ADL_LOG_DIR"
	for c in squeue sbatch scancel scontrol sinfo srun flock nc awk sed grep timeout; do
		if command -v "$c" >/dev/null 2>&1; then
			echo "  found:     $c"
		else
			echo "  MISSING:   $c"
			rc=1
		fi
	done
	# GNU `date -d` is critical: every maintenance calculation goes through it.
	if date -d "2026-09-15T08:00:00" +%s >/dev/null 2>&1; then
		echo "  found:     GNU date -d"
	else
		echo "  MISSING:   GNU date -d"
		rc=1
	fi
	if [ -n "$ADL_PARTITION" ]; then
		echo "  MaxTime:   $(adl_part_maxtime "$ADL_PARTITION")s on $ADL_PARTITION"
		IFS='|' read -r st sw <<<"$(adl_clamp_walltime "$ADL_WALLTIME" "$ADL_PARTITION")"
		echo "  would ask: $st${sw:+  (clamped by $sw)}"
	else
		echo "  MaxTime:   skipped, no partition configured"
		rc=1
	fi
	if adl_maint_open; then
		echo "  maint:     OPEN now ($(adl_maint_window))"
	else
		m=$(adl_maint_next)
		if [ -n "$m" ]; then
			echo "  maint:     next $(date -d "@$m" '+%Y-%m-%d %H:%M')"
		else
			echo "  maint:     none published"
		fi
	fi
	mkdir -p "$ADL_LOG_DIR" && echo "  log dir:   writable" || { echo "  log dir:   NOT WRITABLE"; rc=1; }
	[ "$rc" -eq 0 ] && echo "selftest: OK" || echo "selftest: FAILED"
	exit "$rc"
fi

# --------------------------------------------------------------------------

# Poll for the job to enter RUNNING. $1 = attempts, 3s apart.
settle() {
	local n i=0
	# Bracketed rather than logged per attempt. Attempts are a fixed 3s apart,
	# so the entry and exit lines already give the duration and the count; 20
	# per-attempt lines would add nothing and would bury the rest of the log.
	note "settle: waiting for RUNNING, up to $1 attempts x 3s"
	for _ in $(seq 1 "$1"); do
		sleep 3
		i=$((i + 1))
		n=$(adl_node)
		if [ -n "$n" ]; then
			note "settle: RUNNING on $n after $i attempt(s)"
			return 0
		fi
	done
	note "settle: still not RUNNING after $i attempt(s)"
	return 1
}

# A pending job blocked by a maintenance reservation can be shrunk to fit and
# then starts immediately. Reducing a TimeLimit is permitted to the job owner
# because it only ever releases resources. Any other pending reason (Resources,
# Priority) is a normal queue wait that trimming cannot help, so it is reported
# instead of meddled with.
#
# HARD GUARD: this path only ever SHRINKS. Never make it trim up.
# $1 = settle attempts, 3s each. See the TIME BUDGET above before changing it.
repair_pending() {
	local tries pj why spec cur cs ns
	tries="$1"
	note "repair_pending: checking for a pending job (budget $tries attempts)"
	pj=$(adl_job_pending) || return 1
	if [ -z "$pj" ]; then
		note "repair_pending: nothing pending"
		return 1
	fi

	why=$(adl_pending_reason "$pj")
	case "$why" in
	*Reserved* | *ReqNodeNotAvail*) ;;
	*)
		note "job $pj is queued normally: $why"
		return 1
		;;
	esac

	note "job $pj blocked by maintenance reservation: $why"
	# The reason half is discarded here: this path logs its own, more specific line.
	IFS='|' read -r spec _ <<<"$(adl_clamp_walltime "$ADL_WALLTIME" "$ADL_PARTITION")"
	cur=$(squeue -h -j "$pj" -o '%l' 2>/dev/null | head -1)
	cs=$(adl_tl_seconds "$cur")
	ns=$(adl_tl_seconds "$spec")
	if [ "$ns" -ge "$cs" ]; then
		note "current limit $cur already fits the gap; leaving it alone"
		return 1
	fi

	note "trimming TimeLimit $cur -> $spec so it fits before maintenance"
	# The prototype wrote `>&2 2>&1`, which is backwards: it points stdout at
	# stderr and then points stderr back at the original stdout, which here is
	# the SSH tunnel. Redirect to the log instead so neither can reach stdout.
	scontrol update jobid="$pj" TimeLimit="$spec" >>"$LOGFILE" 2>&1 || {
		note "scontrol update failed; leaving the job alone"
		return 1
	}
	settle "$tries" && {
		note "job $pj now RUNNING on $(adl_node)"
		return 0
	}
	note "job $pj still not running after the trim"
	return 1
}

# --------------------------------------------------------------------------

# The t=0 anchor. Everything above this is sourcing the library and reading the
# conf; everything below is the connect itself, so this line is what later
# elapsed values are read against.
#
# THE LOG IS SPARSER THAN THE NUMBER OF CONNECTS, BY DESIGN. Host amarel-dev
# sets `ControlMaster auto` with `ControlPersist 1800`, so a reconnect inside
# that window multiplexes over the live master and never runs this script at
# all. Measured 2026-09-10: the first connect logged 4 lines and took 3.07s of
# laptop wall clock, of which 0.127s was this script; two reconnects 20s later
# took 0.53-0.58s each and logged nothing. An absent entry means reuse, not a
# lost connect.
note "connect requested (pid $$)"

node=$(adl_node)
note "warm lookup: node=${node:-none}"

# Case 1: something is pending. Repair before provisioning anything new, or
# `dev-session ensure` blocks for five minutes on a job that can never start
# and the editor kills us before we can explain why.
if [ -z "$node" ]; then
	repair_pending 20 || true # <= 60s
	node=$(adl_node)
fi

# Case 2: nothing allocated at all.
if [ -z "$node" ]; then
	if adl_maint_open; then
		# shellcheck disable=SC2046  # deliberate split into $1 start, $2 end
		set -- $(adl_maint_window)
		fail "maintenance until ${2:-the published end}, cannot schedule."
	fi

	note "no allocation; provisioning"
	# flock serialises concurrent connections so several editor windows starting
	# at once cannot each submit their own sbatch. `dev-session ensure` is
	# idempotent, so a waiter simply reports the job the holder made.
	#
	# The lock file is on GPFS, where advisory locking is not always reliable.
	# It held for three concurrent holders on 2026-08-15, and because ensure is
	# idempotent the worst case is a duplicate submission, not corruption.
	# `dev-session`'s own progress lines land in $LOGFILE undated, because its
	# say() is a bare printf and is also the interactive output of
	# `dev-session status`. Timestamping it there would uglify the view a user
	# reads to fix a log a machine reads, so it is bracketed here instead: the
	# two elapsed values below bound everything it did.
	note "provision: acquiring lock, then dev-session ensure"
	timeout 150 flock -w 120 "$HOME/.amarel-dev.lock" \
		timeout 120 "$HOME/bin/dev-session" ensure >>"$LOGFILE" 2>&1
	note "provision: dev-session ensure returned rc=$?"
	node=$(adl_node)
	note "post-provision lookup: node=${node:-none}"

	# The job just submitted may itself collide with a reservation.
	if [ -z "$node" ]; then
		repair_pending 10 || true # <= 30s
		node=$(adl_node)
	fi
fi

if [ -z "$node" ]; then
	pj=$(adl_job_pending)
	if [ -n "$pj" ]; then
		fail "job $pj is queued ($(adl_pending_reason "$pj")) and has not started."
	fi
	fail "no running job and it could not be provisioned. Try: ssh amarel-jump bin/dev-session ensure."
fi

note "connecting to $node"

# A connect got through, so any recorded failure is history. Without this
# `dev-session status` would report a stale failure forever and the skill would
# diagnose a problem that is already gone.
rm -f "$LASTFAIL" 2>/dev/null

# THE LAST LINE THIS SCRIPT CAN EVER WRITE. `exec` replaces the process, so
# nothing after it runs and the nc/SSH handshake itself is not measured. The log
# therefore covers everything up to the handoff and no further. That is inherent
# to being a ProxyCommand, not an omission: a "connected" event would have to
# come from the editor, which is the one place that already knows.
note "handing off to nc -> $node:22"

# `-i 120s`, never a bare `nc`.
#
# Neither node sets ClientAliveInterval, so a dropped VPN falls back to kernel
# TCP keepalive: tcp_keepalive_time 7200 + 9 x 75 = 7875s, about 2h11m. Without
# the flag every VPN drop or closed lid strands an `nc` on the LOGIN NODE for
# that long, and several drops a day means several strays. Login node resource
# use is precisely OARC's complaint, so this is hygiene. It ends no job.
#
# COUPLED NUMBER, IN A DIFFERENT FILE: the 120s only works because the laptop's
# ssh_config sets `ServerAliveInterval 15` on Host amarel-dev. Measured
# 2026-08-20: with ServerAliveInterval 15 and `nc -i 120s`, 45s idle survives;
# with no keepalive and `nc -i 20s`, 45s idle gives "Ncat: Idle timeout
# expired". Change one and you must change the other.
exec nc -i 120s "$node" 22
